static int is_word_char(unsigned char c) {
    return isalpha(c) || c == '\'';
}

static int process_token(SearchEngine *e, Document *d,
                         char *token, size_t *len) {
    if (*len == 0)
        return 1;

    token[*len] = '\0';

    if (!add_occurrence(e, d->id, token))
        return 0;

    d->total_terms++;

    (*len) = 0;

    return 1;
}
