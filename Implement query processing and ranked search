static int tokenize_query(const char *query, char terms[][MAX_TOKEN]) {
    int count = 0;
    char token[MAX_TOKEN];
    size_t len = 0;
    size_t i;

    for (i = 0; query[i] != '\0'; i++) {
        unsigned char c = (unsigned char)query[i];

        if (is_word_char(c)) {
            if (len < MAX_TOKEN - 1)
                token[len++] = (char)tolower(c);
        } else if (len > 0) {
            token[len] = '\0';

            int duplicate = 0, j;

            for (j = 0; j < count; j++)
                if (strcmp(terms[j], token) == 0)
                    duplicate = 1;

            if (!duplicate && count < MAX_QUERY_TERMS)
                strcpy(terms[count++], token);

            len = 0;
        }
    }

    if (len > 0 && count < MAX_QUERY_TERMS) {
        token[len] = '\0';

        int duplicate = 0, j;

        for (j = 0; j < count; j++)
            if (strcmp(terms[j], token) == 0)
                duplicate = 1;

        if (!duplicate)
            strcpy(terms[count++], token);
    }

    return count;
}

static int compare_results(const void *a, const void *b) {
    const SearchResult *x = (const SearchResult *)a;
    const SearchResult *y = (const SearchResult *)b;

    if (x->score < y->score)
        return 1;

    if (x->score > y->score)
        return -1;

    return x->doc_id - y->doc_id;
}

static void append_match(char *buffer, size_t capacity, const char *word) {
    size_t used = strlen(buffer);
    size_t remaining;

    if (used >= capacity - 1)
        return;

    remaining = capacity - used - 1;

    if (used > 0 && remaining > 2) {
        memcpy(buffer + used, ", ", 2);
        used += 2;
        remaining -= 2;
    }

    if (remaining > 0) {
        size_t n = strlen(word);

        if (n > remaining)
            n = remaining;

        memcpy(buffer + used, word, n);
        buffer[used + n] = '\0';
    }
}

static int search_engine(SearchEngine *e, const char *query,
                         SearchResult **out_results, int *out_count) {
    char terms[MAX_QUERY_TERMS][MAX_TOKEN];

    int term_count = tokenize_query(query, terms);

    long *scores = (long *)malloc(
        ((size_t)e->document_count + 1) * sizeof(long));

    char (*matched)[1024] = malloc(
        ((size_t)e->document_count + 1) * sizeof(*matched));

    if (scores)
        memset(scores, 0,
               ((size_t)e->document_count + 1) * sizeof(long));

    if (matched)
        memset(matched, 0,
               ((size_t)e->document_count + 1) * sizeof(*matched));

    int i, count = 0;
    SearchResult *results;

    if (!scores || !matched) {
        free(scores);
        free(matched);
        return 0;
    }

    for (i = 0; i < term_count; i++) {
        TermNode *t = find_term(e, terms[i]);
        Posting *p;

        if (!t)
            continue;

        for (p = t->postings; p; p = p->next) {
            scores[p->doc_id] += p->frequency;

            append_match(matched[p->doc_id],
                         sizeof(matched[p->doc_id]), terms[i]);
        }
    }

    for (i = 1; i <= e->document_count; i++)
        if (scores[i] > 0)
            count++;

    results = (SearchResult *)malloc(
        (size_t)(count ? count : 1) * sizeof(*results));

    if (!results) {
        free(scores);
        free(matched);
        return 0;
    }

    memset(results, 0,
           (size_t)(count ? count : 1) * sizeof(*results));

    count = 0;

    for (i = 1; i <= e->document_count; i++) {
        if (scores[i] > 0) {
            results[count].doc_id = i;
            results[count].score = scores[i];

            strcpy(results[count].matched, matched[i]);

            count++;
        }
    }

    /* Bubble sort: descending score, then ascending document ID. */
    for (i = 0; i < count - 1; i++) {
        int j;

        for (j = 0; j < count - 1 - i; j++) {
            if (compare_results(&results[j], &results[j + 1]) > 0) {
                SearchResult temp = results[j];

                results[j] = results[j + 1];
                results[j + 1] = temp;
            }
        }
    }

    free(scores);
    free(matched);

    *out_results = results;
    *out_count = count;

    return term_count;
}
