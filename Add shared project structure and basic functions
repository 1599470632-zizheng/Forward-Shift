#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_LINE 4096
#define MAX_TOKEN 128
#define MAX_QUERY_TERMS 128
#define DEFAULT_TOP_K 10

typedef struct Posting {
    int doc_id;
    int frequency;
    struct Posting *next;
} Posting;

typedef struct TermNode {
    char *term;
    Posting *postings;
    struct TermNode *next;
} TermNode;

typedef struct Document {
    int id;
    char *path;
    long total_terms;
    long unique_terms;
    struct Document *next;
} Document;

typedef struct {
    Document *documents;
    TermNode *index;
    int document_count;
    long total_terms;
    long posting_count;
    int unique_terms;
} SearchEngine;

typedef struct {
    int doc_id;
    long score;
    char matched[1024];
} SearchResult;

static char *duplicate_string(const char *s) {
    size_t n = strlen(s) + 1;
    char *p = (char *)malloc(n);
    if (p) memcpy(p, s, n);
    return p;
}

static void init_engine(SearchEngine *e) {
    memset(e, 0, sizeof(*e));
}

static void free_engine(SearchEngine *e) {
    Document *d = e->documents;
    while (d) {
        Document *next = d->next;
        free(d->path);
        free(d);
        d = next;
    }

    TermNode *t = e->index;
    while (t) {
        TermNode *tn = t->next;
        Posting *p = t->postings;

        while (p) {
            Posting *pn = p->next;
            free(p);
            p = pn;
        }

        free(t->term);
        free(t);
        t = tn;
    }

    init_engine(e);
}

static Document *find_document(SearchEngine *e, int id) {
    Document *d;

    for (d = e->documents; d; d = d->next) {
        if (d->id == id)
            return d;
    }

    return NULL;
}
